#!/usr/bin/env python3
"""brain — deterministic second-brain CLI for two Obsidian vaults. Stdlib only."""

import argparse
import sys
from pathlib import Path

# scripts/brain imports scripts/lib/*
sys.path.insert(0, str(Path(__file__).resolve().parent))

VERSION = "1.3.0"

from lib import capture, edit, query, vaultdocs  # noqa: E402
from lib.core import (config_path, current_mode, iso_week, name_parts,
                      owner_name, owner_problem, read_config, require_owner,
                      resolve_ctx, set_mode, setting, today, vault_path,
                      write_config)  # noqa: E402
from lib.core import TYPE_BY_FOLDER  # noqa: E402
from lib.linter import fix_safe, lint_vault, orphans  # noqa: E402


def build_parser():
    p = argparse.ArgumentParser(
        prog="brain",
        description="second-brain — deterministic CLI for two Obsidian vaults "
                    "(work + personal)")
    p.add_argument("--version", action="version", version=f"second-brain {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True)

    ip = sub.add_parser("init", help="write the config file and create the vault "
                                     "folders (safe to re-run)")
    ip.add_argument("--work-vault", metavar="PATH")
    ip.add_argument("--personal-vault", metavar="PATH")
    ip.add_argument("--owner", metavar="NAME",
                    help="your People-note name, e.g. \"Maya Chen\"")
    ip.add_argument("--org-domain", metavar="DOMAIN",
                    help="emails at this domain are org: internal (e.g. example.com)")

    sub.add_parser("status", help="mode, vault path, today, ISO week")

    up = sub.add_parser("update", help="install the latest brain-kit release "
                                       "(the only command that uses the network)")
    up.add_argument("--check", action="store_true",
                    help="only report whether a newer release exists")
    up.add_argument("--to", metavar="TAG",
                    help="install this release tag instead of the latest "
                         "(pin or roll back)")

    mp = sub.add_parser("mode", help="get/set active vault")
    mp.add_argument("value", nargs="?", choices=["work", "personal"])
    mp.add_argument("--because", metavar="QUOTE",
                    help="the user's own words asking for the other vault; "
                         "required to CHANGE the mode and must name that vault")

    cap = sub.add_parser("capture", help="capture artifacts atomically")
    csub = cap.add_subparsers(dest="what", required=True)

    m = csub.add_parser("meeting")
    m.add_argument("--title", required=True)
    m.add_argument("--date")
    m.add_argument("--attendees")
    m.add_argument("--project")
    m.add_argument("--transcript-file",
                   help="raw source file; REQUIRES --summary-file")
    m.add_argument("--task", action="append", metavar="DESC|AREA|PRIORITY|OWNER")
    m.add_argument("--followup", action="append", metavar="WHO|ABOUT")
    m.add_argument("--decision", action="append", metavar="TEXT",
                   help="repeatable; one literal decision from the source")
    m.add_argument("--summary-file")
    m.add_argument("--summary-stdin", action="store_true")

    i = csub.add_parser("interview")
    i.add_argument("--candidate", required=True)
    i.add_argument("--role", required=True)
    i.add_argument("--round", required=True)
    i.add_argument("--date")
    i.add_argument("--transcript-file",
                   help="raw source file; REQUIRES --assessment-file or --note")
    i.add_argument("--note", action="append", metavar="TEXT",
                   help="repeatable; goes to ## Notes During Interview")
    i.add_argument("--assessment-file", help="prose for ## Assessment")
    i.add_argument("--verdict", choices=["pending", "hire", "no-hire"],
                   help="set from an explicit recommendation in the source")
    i.add_argument("--summary-file")
    i.add_argument("--summary-stdin", action="store_true")

    t = csub.add_parser("task")
    t.add_argument("--desc", required=True)
    t.add_argument("--area", required=True,
                   choices=["client", "internal", "admin", "learning"])
    t.add_argument("--owner", metavar="NAME",
                   help="who owes this (default: the vault owner). Someone else's action "
                        "item must carry their name.")
    t.add_argument("--context", help="one line of source context for the body")
    t.add_argument("--priority", choices=["high", "medium", "low"])
    t.add_argument("--project")
    t.add_argument("--source")
    t.add_argument("--this-week", action="store_true", dest="this_week",
                   help="capture directly into this week's priorities")

    n = csub.add_parser("note")
    n.add_argument("--title", required=True)
    n.add_argument("--folder", choices=["Reference", "Content"])
    n.add_argument("--body-file")

    pe = csub.add_parser("person")
    pe.add_argument("--name", required=True)
    pe.add_argument("--org", choices=["internal", "external"],
                    help="internal = your own organization")
    pe.add_argument("--role")
    pe.add_argument("--email")

    pj = csub.add_parser("project")
    pj.add_argument("--name", required=True)
    pj.add_argument("--area", choices=["client", "internal", "admin", "learning"],
                    help="default: internal")
    pj.add_argument("--context-file", help="prose for ## Context")

    rp = csub.add_parser("repo")
    rp.add_argument("--name", required=True)
    rp.add_argument("--project", required=True, metavar="SLUG",
                    help="must name an existing project note")
    rp.add_argument("--role", help="e.g. api, frontend, infra")
    rp.add_argument("--path", help="default: the current directory")
    rp.add_argument("--remote", help="default: this directory's git remote, if any")
    rp.add_argument("--purpose", help="one line for ## Purpose")
    rp.add_argument("--status", choices=["active", "archived"])

    f = csub.add_parser("followup")
    f.add_argument("--who", required=True)
    f.add_argument("--about", required=True)

    x = sub.add_parser("extract-tasks",
                       help="atomic tasks-only capture (e.g. from a transcript)")
    x.add_argument("--task", action="append", required=True,
                   metavar="DESC|AREA|PRIORITY|OWNER")
    x.add_argument("--project")
    x.add_argument("--source")
    x.add_argument("--transcript-file")
    x.add_argument("--title")
    x.add_argument("--date")

    q = sub.add_parser("query", help="one-shot read queries")
    qsub = q.add_subparsers(dest="what", required=True)
    qt = qsub.add_parser("tasks")
    qt.add_argument("--status", choices=["backlog", "this-week", "done"])
    qt.add_argument("--project")
    qt.add_argument("--area", choices=["client", "internal", "admin", "learning"])
    qt.add_argument("--priority", choices=["high", "medium", "low"])
    qt.add_argument("--week", metavar="YYYY-Www")
    qt.add_argument("--owner", default="me",
                    help="'me' (default, the vault owner), 'all', or a person's name")
    qsub.add_parser("working-on")
    qsub.add_parser("waiting-on")
    qsub.add_parser("today")
    qp = qsub.add_parser("person")
    qp.add_argument("name")
    qj = qsub.add_parser("project")
    qj.add_argument("name")
    qr = qsub.add_parser("repo", help="repo status; no name auto-detects the "
                         "current directory")
    qr.add_argument("name", nargs="?")
    qrs = qsub.add_parser("repos", help="repos of every status")
    qrs.add_argument("--project", metavar="SLUG")
    qrs.add_argument("--status", choices=["active", "archived", "all"], default="all")
    qm = qsub.add_parser("meetings")
    qm.add_argument("--since")
    qm.add_argument("--until")
    qm.add_argument("--project", metavar="SLUG")
    qm.add_argument("--attendee", metavar="NAME")
    qn = qsub.add_parser("notes", help="Reference and Content notes; one match "
                         "prints the whole note")
    qn.add_argument("text", nargs="?", default="")
    qn.add_argument("--folder", choices=["Reference", "Content"])
    qn.add_argument("--status", choices=["draft", "published"],
                    help="Content notes only")
    qs = qsub.add_parser("show", help="print one note in full")
    qs.add_argument("link", help="Folder/stem exactly as other queries print it")
    qpj = qsub.add_parser("projects", help="projects of every status")
    qpj.add_argument("--status", choices=["active", "paused", "done", "all"],
                     default="all")
    qpj.add_argument("--area", choices=["client", "internal", "admin", "learning"])
    qf = qsub.add_parser("followups", help="open (default) or closed follow-ups")
    qf.add_argument("--status", choices=["waiting", "done", "all"], default="waiting")
    qf.add_argument("--who", metavar="NAME")
    qi = qsub.add_parser("interviews")
    qi.add_argument("--verdict", choices=["pending", "hire", "no-hire"])
    qi.add_argument("--candidate", metavar="NAME")
    qi.add_argument("--role", metavar="WORDS")
    qi.add_argument("--since")
    qpe = qsub.add_parser("people")
    qpe.add_argument("--org", choices=["internal", "external"])
    qpe.add_argument("--text", metavar="WORDS", help="matches name or role")
    qd = qsub.add_parser("dailies")
    qd.add_argument("--since")
    qd.add_argument("--until")
    qtr = qsub.add_parser("transcripts")
    qtr.add_argument("--since")
    qse = qsub.add_parser("search", help="find notes whose text has all the words")
    qse.add_argument("text")
    qse.add_argument("--type", choices=sorted(TYPE_BY_FOLDER.values()))
    qse.add_argument("--since")

    st = sub.add_parser("set", help="change fields of an existing note")
    stsub = st.add_subparsers(dest="type", required=True)
    TASK_AREAS = ["client", "internal", "admin", "learning"]
    s = stsub.add_parser("task")
    s.add_argument("ref", help="task slug from `query tasks`")
    s.add_argument("--status", choices=["backlog", "this-week", "done"])
    s.add_argument("--priority", choices=["high", "medium", "low"])
    s.add_argument("--area", choices=TASK_AREAS)
    s.add_argument("--owner", metavar="NAME")
    s.add_argument("--project", metavar="SLUG|none")
    s.add_argument("--desc", help="new title; the filename never changes")
    s.add_argument("--week", metavar="YYYY-Www")
    s = stsub.add_parser("followup")
    s.add_argument("ref")
    s.add_argument("--status", choices=["waiting", "done"])
    s.add_argument("--about")
    s = stsub.add_parser("project")
    s.add_argument("ref")
    s.add_argument("--status", choices=["active", "paused", "done"])
    s.add_argument("--area", choices=TASK_AREAS)
    s = stsub.add_parser("repo")
    s.add_argument("ref")
    s.add_argument("--status", choices=["active", "archived"])
    s.add_argument("--role", metavar="TEXT|none")
    s.add_argument("--project", metavar="SLUG")
    s.add_argument("--path", metavar="PATH|none")
    s.add_argument("--remote", metavar="URL|none")
    s = stsub.add_parser("person")
    s.add_argument("ref")
    s.add_argument("--org", choices=["internal", "external"])
    s.add_argument("--role", metavar="TEXT|none")
    s.add_argument("--email", metavar="TEXT|none")
    s = stsub.add_parser("interview")
    s.add_argument("ref")
    s.add_argument("--verdict", choices=["pending", "hire", "no-hire"])
    s.add_argument("--round")
    s = stsub.add_parser("content")
    s.add_argument("ref")
    s.add_argument("--status", choices=["draft", "published"])
    s = stsub.add_parser("meeting")
    s.add_argument("ref")
    s.add_argument("--project", metavar="SLUG|none")
    s.add_argument("--add-attendee", action="append", metavar="NAME")
    s.add_argument("--remove-attendee", action="append", metavar="NAME")

    ap = sub.add_parser("append", help="add prose to an existing note's section")
    apsub = ap.add_subparsers(dest="type", required=True)

    def _prose(sp):
        sp.add_argument("--text")
        sp.add_argument("--file")

    for t in ("reference", "content", "person", "followup", "task", "repo"):
        s = apsub.add_parser(t)
        s.add_argument("ref")
        _prose(s)
    s = apsub.add_parser("project")
    s.add_argument("ref")
    _prose(s)
    s.add_argument("--milestone", action="append", metavar="TEXT")
    s = apsub.add_parser("meeting")
    s.add_argument("ref")
    _prose(s)
    s.add_argument("--decision", action="append", metavar="TEXT")
    s = apsub.add_parser("interview")
    s.add_argument("ref")
    _prose(s)
    s.add_argument("--note", action="append", metavar="TEXT")
    s = apsub.add_parser("daily")
    s.add_argument("ref", nargs="?", metavar="YYYY-MM-DD")
    s.add_argument("--log", action="append", metavar="TEXT")
    s.add_argument("--dump", action="append", metavar="TEXT")

    pr = sub.add_parser("promote", help="task backlog -> this-week")
    pr.add_argument("--task", action="append", required=True, metavar="SLUG")
    pr.add_argument("--week", default="auto")

    dn = sub.add_parser("done", help="mark task done")
    dn.add_argument("--task", action="append", required=True, metavar="SLUG")

    lp = sub.add_parser("lint", help="validate vault(s)")
    lp.add_argument("--fix-safe", action="store_true")
    lp.add_argument("--vault", choices=["work", "personal", "both"], default="both")

    dp = sub.add_parser("doctor", help="vault health: lint errors, broken links, orphans")
    dp.add_argument("--vault", choices=["work", "personal", "both"], default="both")
    return p


def cmd_init(args):
    if args.owner is not None and not name_parts(args.owner):
        print(f"ERROR: --owner {args.owner!r} has no Latin letters. Your People "
              "note is named Firstname-Lastname in Latin script; pass a "
              "romanized spelling. Nothing was written.", file=sys.stderr)
        return 2
    cfg = read_config()
    for key, val in (("BRAIN_WORK_VAULT", args.work_vault),
                     ("BRAIN_PERSONAL_VAULT", args.personal_vault),
                     ("BRAIN_OWNER", args.owner),
                     ("BRAIN_ORG_DOMAIN", args.org_domain)):
        if val:
            if key.endswith("_VAULT"):
                val = str(Path(val).expanduser().resolve())
            cfg[key] = val.strip()
    if not (cfg.get("BRAIN_WORK_VAULT") or cfg.get("BRAIN_PERSONAL_VAULT")
            or cfg.get("BRAIN_ROOT")):
        print("ERROR: brain init needs --work-vault PATH (and usually "
              "--personal-vault PATH).", file=sys.stderr)
        return 2
    path = write_config(cfg)
    print(f"config: {path}")
    owner = cfg.get("BRAIN_OWNER") or setting("BRAIN_OWNER")
    parts = name_parts(owner)
    owner_link = f"[[People/{'-'.join(parts)}]]" if parts else None
    for mode, key in (("work", "BRAIN_WORK_VAULT"),
                      ("personal", "BRAIN_PERSONAL_VAULT")):
        if cfg.get(key):
            vault = Path(cfg[key]).expanduser()
            print(f"{mode} vault: {vault}")
            for line in vaultdocs.write_all(vault, mode, owner_link):
                print(f"  {line}")
    if not owner_link:
        print("NOTE: no usable owner set yet. Run `brain init --owner "
              "\"Your Name\"` (Latin letters) before capturing.")
    return 0


def cmd_status(ctx):
    mode = current_mode(ctx)
    print(f"second-brain {VERSION}")
    print(f"mode: {mode}")
    problem = owner_problem()
    if problem == "unset":
        print("owner: (unset — run brain init --owner NAME)")
    elif problem:
        print(f"owner: {owner_name()} (INVALID: {problem} — run brain init "
              "--owner NAME)")
    else:
        print(f"owner: {owner_name()}")
    print(f"org domain: {setting('BRAIN_ORG_DOMAIN') or '(unset)'}")
    print(f"vault: {vault_path(ctx, mode)}")
    print(f"work vault: {ctx.vaults.get('work')}")
    print(f"personal vault: {ctx.vaults.get('personal')}")
    print(f"config: {ctx.source}")
    print(f"config file: {config_path()}")
    print(f"mode file: {ctx.mode_file}")
    print(f"today: {today().isoformat()}")
    print(f"week: {iso_week()}")


def cmd_lint(ctx, args):
    vaults = ["work", "personal"] if args.vault == "both" else [args.vault]
    total_errs = 0
    for mode in vaults:
        vault = ctx.vaults.get(mode)
        if vault is None or not vault.is_dir():
            continue
        if args.fix_safe:
            for rel, desc in fix_safe(vault):
                print(f"FIXED {mode}/{rel}: {desc}")
        errs, warns = lint_vault(vault)
        for rel, field, prob in errs:
            print(f"{mode}/{rel}:{field}:{prob}")
        for rel, field, prob in warns:
            print(f"WARN {mode}/{rel}:{field}:{prob}")
        total_errs += len(errs)
    print(f"lint: {'clean' if total_errs == 0 else str(total_errs) + ' error(s)'}")
    return 1 if total_errs else 0


def cmd_doctor(ctx, args):
    vaults = ["work", "personal"] if args.vault == "both" else [args.vault]
    bad = 0
    for mode in vaults:
        vault = ctx.vaults.get(mode)
        if vault is None or not vault.is_dir():
            continue
        errs, warns = lint_vault(vault)
        orph = orphans(vault)
        links = [w for w in warns if w[1] == "body"]
        other = [w for w in warns if w[1] != "body"]
        print(f"== {mode}: {len(errs)} lint error(s), {len(links)} broken link(s), "
              f"{len(other)} warning(s), {len(orph)} orphan(s)")
        for rel, field, prob in errs:
            print(f"ERROR  {rel}:{field}:{prob}")
        for rel, _, prob in links:
            print(f"BROKEN {rel}: {prob}")
        for rel, field, prob in other:
            print(f"WARN   {rel}:{field}:{prob}")
        for rel in orph:
            print(f"ORPHAN {rel}")
        bad += len(errs)
    print(f"doctor: {'healthy' if bad == 0 else str(bad) + ' error(s)'}")
    return 1 if bad else 0


def main():
    # Windows consoles default to a legacy code page; names like "Inés" must
    # print and read the same on every OS.
    for stream in (sys.stdin, sys.stdout, sys.stderr):
        if hasattr(stream, "reconfigure"):
            stream.reconfigure(encoding="utf-8")
    args = build_parser().parse_args()
    if args.cmd == "init":
        return cmd_init(args)
    if args.cmd == "update":  # needs no config
        from lib import update
        return update.run(VERSION, check=args.check, to=args.to)
    ctx = resolve_ctx()

    if args.cmd == "status":
        return cmd_status(ctx)
    if args.cmd == "mode":
        if args.value:
            if args.value == current_mode(ctx):
                print(f"mode: {args.value} (already active, unchanged)")
                return 0
            set_mode(ctx, args.value, args.because)
            print(f"mode: {args.value}")
            print(f"switched because the user said: {args.because}")
        else:
            print(f"mode: {current_mode(ctx)}")
        return 0
    if args.cmd == "lint":
        return cmd_lint(ctx, args)
    if args.cmd == "doctor":
        return cmd_doctor(ctx, args)
    require_owner()

    mode = current_mode(ctx)
    if args.cmd == "capture":
        fn = {"meeting": capture.cmd_capture_meeting,
              "interview": capture.cmd_capture_interview,
              "task": capture.cmd_capture_task,
              "note": capture.cmd_capture_note,
              "person": capture.cmd_capture_person,
              "project": capture.cmd_capture_project,
              "repo": capture.cmd_capture_repo,
              "followup": capture.cmd_capture_followup}[args.what]
        for attr in ("about", "role", "email", "desc", "name", "title", "candidate",
                     "who", "context", "purpose"):  # one-line flags never carry a newline
            if isinstance(getattr(args, attr, None), str):
                setattr(args, attr, " ".join(getattr(args, attr).split()))
        return fn(ctx, mode, args)
    if args.cmd == "set":
        return edit.cmd_set(ctx, mode, args)
    if args.cmd == "append":
        return edit.cmd_append(ctx, mode, args)
    if args.cmd == "extract-tasks":
        return capture.cmd_extract_tasks(ctx, mode, args)
    if args.cmd == "promote":
        return capture.cmd_promote(ctx, mode, args)
    if args.cmd == "done":
        return capture.cmd_done(ctx, mode, args)
    if args.cmd == "query":
        vault = vault_path(ctx, mode)
        fn = {"tasks": query.cmd_tasks, "working-on": query.cmd_working_on,
              "waiting-on": query.cmd_waiting_on, "today": query.cmd_today,
              "person": query.cmd_person, "project": query.cmd_project,
              "repo": query.cmd_repo, "repos": query.cmd_repos,
              "meetings": query.cmd_meetings, "notes": query.cmd_notes,
              "show": query.cmd_show, "projects": query.cmd_projects,
              "followups": query.cmd_followups,
              "interviews": query.cmd_interviews, "people": query.cmd_people,
              "dailies": query.cmd_dailies, "transcripts": query.cmd_transcripts,
              "search": query.cmd_search}[args.what]
        return fn(vault, args)
    return 0


if __name__ == "__main__":
    sys.exit(main() or 0)
